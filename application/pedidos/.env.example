# Copie para .env (ignorado pelo git) no diretório de onde a aplicação é iniciada.
# O Spring lê este arquivo via spring.config.import; variáveis de ambiente do sistema têm prioridade.

# Envio de métricas ao Pushgateway da stack SRE
PUSHGATEWAY_ENABLED=true
PUSHGATEWAY_ADDRESS=<host-da-stack-sre>:9091
PUSHGATEWAY_PUSH_RATE=20s
PUSHGATEWAY_INSTANCE=local

# Envio de traces ao Jaeger (OTLP HTTP)
OTLP_TRACING_ENABLED=true
OTLP_TRACING_ENDPOINT=http://<host-da-stack-sre>:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0

# Nível de log da aplicação (DEBUG só em desenvolvimento)
APP_LOG_LEVEL=INFO
